DATABASE_URL=postgres://user:pass@localhost:5432/seenq?sslmode=disable
SERP_API_KEY=

# DeepSeek Flash only (cheap) — used for every LLM + GEO card
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-flash
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=
VISORA_LLM_MODEL=deepseek-flash
GEO_OPENAI_BASE_URL=https://api.deepseek.com/v1
GEO_OPENAI_API_KEY=
GEO_MODEL_GPT=deepseek-flash
GEO_MODEL_CLAUDE=deepseek-flash
GEO_MODEL_GEMINI=deepseek-flash
GEO_MODEL_GROK=deepseek-flash

CRAWL_CONCURRENCY=4
CRAWL_DELAY_MS=250
SERP_CONCURRENCY=2
GEO_CONCURRENCY=2

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JWT_SECRET=
COOKIE_DOMAIN=
FRONTEND_URL=http://localhost:7000
API_BASE_EXTERNAL=http://localhost:7001
TURNSTILE_SECRET_KEY=

# Quotas are account based — never IP. One full scan per Google account.
GUEST_MAX_SCANS=1
USER_MAX_SCANS=1
USER_MAX_SCANS_PER_DAY=1

# Redis (scan quotas + burst rate limits)
REDIS_ADDR=redis:6379
# REDIS_URL=redis://redis:6379/0
# REDIS_PASSWORD=
RATE_LIMIT_CREATE_MAX=8
RATE_LIMIT_CREATE_WINDOW_SEC=3600
RATE_LIMIT_AUTH_MAX=12
RATE_LIMIT_AUTH_WINDOW_SEC=600
RATE_LIMIT_API_MAX=120
RATE_LIMIT_API_WINDOW_SEC=60
